source = unified.read_text(encoding='utf-8')
start_marker = '@Composable\nprivate fun WeeklyChampionPodium('
end_marker = '@Composable\nprivate fun UnifiedHeroMetric'
start = source.find(start_marker)
end = source.find(end_marker, start)
if start < 0 or end < 0:
    raise SystemExit('Weekly podium markers not found; refusing unsafe patch')

