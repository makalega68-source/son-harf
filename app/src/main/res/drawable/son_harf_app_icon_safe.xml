<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Keep the manifest pointed at a stable XML drawable so the launcher never depends on a
      directly-declared raster resource. The visible artwork is the user's supplied SH icon,
      re-encoded as a validated PNG in drawable-nodpi.
    -->
    <item>
        <bitmap
            android:src="@drawable/son_harf_gold_teal_logo"
            android:gravity="fill" />
    </item>
</layer-list>
