<?xml version="1.0" encoding="utf-8"?>
<!-- Obi fills the whole launcher shape (no empty corners): the orb is drawn larger than the
     108dp adaptive canvas so the mask cuts through its glowing rim; the face stays inside
     the 66dp safe zone. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="-5dp" android:top="-5dp" android:right="-5dp" android:bottom="-5dp">
        <bitmap android:src="@drawable/obi_launcher_sleepy" android:gravity="fill" android:filter="true" />
    </item>
</layer-list>
