<?xml version="1.0" encoding="utf-8"?>
<!-- App launcher (adaptive icon). Foreground is the new app_logo.webp
     (user-supplied, see res/drawable-nodpi/app_logo.webp). The launcher
     surface masks a circle/squircle over this, so the shield + K stays
     centered inside the safe zone. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/kelime_tahti_launcher_background" />
    <foreground android:drawable="@drawable/app_logo" />
</adaptive-icon>
