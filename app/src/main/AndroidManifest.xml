<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
    <!-- Android 11+ hides speech recognition and TTS engines unless the app declares them. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
    <application
        android:theme="@style/Theme.SonHarf"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_kelime_tahti"
        android:roundIcon="@mipmap/ic_kelime_tahti"
        android:allowBackup="false"
        android:supportsRtl="true">
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${ADMOB_APP_ID}" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sonharf" android:host="auth" />
            </intent-filter>
        </activity>
        <!-- Launcher entry with the mascot's "happy" face; MascotLauncherIcon enables exactly one. -->
        <activity-alias
            android:name=".LauncherMascotHappy"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_kelime_tahti_mascot_happy"
            android:roundIcon="@mipmap/ic_kelime_tahti_mascot_happy">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- Launcher entry with the mascot's "sad" face; MascotLauncherIcon enables exactly one. -->
        <activity-alias
            android:name=".LauncherMascotSad"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_kelime_tahti_mascot_sad"
            android:roundIcon="@mipmap/ic_kelime_tahti_mascot_sad">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- Launcher entry with the mascot's "angry" face; MascotLauncherIcon enables exactly one. -->
        <activity-alias
            android:name=".LauncherMascotAngry"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_kelime_tahti_mascot_angry"
            android:roundIcon="@mipmap/ic_kelime_tahti_mascot_angry">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- Launcher entry with the mascot's "sleepy" face; MascotLauncherIcon enables exactly one. -->
        <activity-alias
            android:name=".LauncherMascotSleepy"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_kelime_tahti_mascot_sleepy"
            android:roundIcon="@mipmap/ic_kelime_tahti_mascot_sleepy">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <receiver
            android:name=".MascotIconMoodReceiver"
            android:exported="false" />
    </application>
</manifest>
